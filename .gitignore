# Dependencies
node_modules/
__pycache__/
*.pyc
.pytest_cache/
venv/
env/
.venv/

# Environment files — NEVER commit!
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env

# Build outputs
frontend/build/
dist/
*.egg-info/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/
htmlcov/
.coverage

# Database
*.sqlite
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*.suo

# Docker volumes (local)
mysql_data/
redis_data/

# Uploads (user content — not in VCS)
backend/uploads/*
!backend/uploads/.gitkeep

# ML model files (too large for git — use Git LFS)
ml_service/models/*.pkl
ml_service/models/*.joblib
ml_service/models/*.h5

# SSL certificates
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt

# Test reports
junit.xml
test-results/

# Misc
*.bak
*.tmp
.cache/
