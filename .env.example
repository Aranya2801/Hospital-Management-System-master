# ================================================================
#  MedCore HMS — Environment Configuration
#  Copy this file to .env and fill in your values
#  NEVER commit .env to version control!
# ================================================================

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── MySQL Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Authentication ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-characters
JWT_REFRESH_SECRET=another-different-long-random-secret-key-for-refresh-tokens
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-hospital-email@gmail.com
SMTP_PASS=your-google-app-password

# ─── SMS (Twilio) ───────────────────────────────────────────────
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_FROM=+919876543210

# ─── Payment Gateway (Razorpay) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_key_secret

# ─── File Upload ────────────────────────────────────────────────
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ─── AI / ML Service ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001
ML_API_KEY=your_ml_service_api_key

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ─── Session ────────────────────────────────────────────────────
SESSION_SECRET=your-session-secret-key

# ─── Frontend (React) ───────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000/api/v1
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_RAZORPAY_KEY=rzp_test_xxxxxxxxxx
